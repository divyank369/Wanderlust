<% layout('/layouts/boilerplate') %>

<main class="auth-page">
    <section class="auth-panel" aria-labelledby="auth-title">
        <div class="auth-brand-mark" aria-hidden="true"><i class="fa-regular fa-compass"></i></div>
        <p class="auth-eyebrow">WELCOME BACK</p>
        <h1 id="auth-title">Your next escape awaits.</h1>
        <p class="auth-intro">Log in to pick up where your travels left off.</p>

        <form action="/login" method="POST" novalidate class="needs-validation auth-form">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input id="username" name="username" type="text" class="form-control" autocomplete="username" placeholder="Your username" required />
                <div class="invalid-feedback">Please enter your username.</div>
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" placeholder="Your password" required />
                <div class="invalid-feedback">Please enter your password.</div>
            </div>
            <button class="btn auth-submit" type="submit">Log in <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-switch">New to Wanderlust? <a href="/signup">Create an account</a></p>
    </section>
    <aside class="auth-visual auth-visual-login" aria-label="A scenic coastal destination">
        <div class="auth-visual-copy">
            <span class="auth-visual-kicker">THE WORLD IS STILL OUT THERE</span>
            <p>Come back<br>to the feeling.</p>
        </div>
    </aside>
</main>
