<% layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/css/filters.css">
<div class="filters-header">
  <div class="filters-title">Filters</div>
  <button id="filters-seeall-btn" class="filters-seeall">See all</button>
</div>
<div id="filters" class="filters-bar">

  <div class="filter" data-filter="Trending" <%= (typeof filter !== 'undefined' && filter==='Trending') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-fire"></i><p>Trending</p></div>
  <div class="filter" data-filter="Rooms"><i class="fa-solid fa-bed"></i><p>Rooms</p></div>
  <div class="filter" data-filter="Nearby"><i class="fa-solid fa-location-dot"></i><p>Nearby</p></div>
  <div class="filter" data-filter="Iconic Cities" <%= (typeof filter !== 'undefined' && filter==='Iconic Cities') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-mountain-city"></i><p>Iconic Cities</p></div>
  <div class="filter" data-filter="Mountains" <%= (typeof filter !== 'undefined' && filter==='Mountains') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-mountain-sun"></i><p>Mountains</p></div>
  <div class="filter" data-filter="Amazing Pools" <%= (typeof filter !== 'undefined' && filter==='Amazing Pools') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-person-swimming"></i><p>Amazing Pools</p></div>
  <div class="filter" data-filter="Castles" <%= (typeof filter !== 'undefined' && filter==='Castles') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-place-of-worship"></i><p>Castles</p></div>
  <div class="filter" data-filter="Camping" <%= (typeof filter !== 'undefined' && filter==='Camping') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-campground"></i><p>Camping</p></div>
  <div class="filter" data-filter="Farms" <%= (typeof filter !== 'undefined' && filter==='Farms') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-cow"></i><p>Farms</p></div>
  <div class="filter" data-filter="Arctic" <%= (typeof filter !== 'undefined' && filter==='Arctic') ? 'aria-current="true"' : '' %> ><i class="fa-solid fa-snowflake"></i><p>Arctic</p></div>

  <div class="tax-toggle" style="margin-left:auto;">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display Total after taxes</label>
    </div>
  </div>

 </div>
 <script src="/js/filters.js" defer></script>

<% if (typeof q !== 'undefined' && q && q.trim().length > 0) { %>
  <div class="mb-3"><strong>Search results for "<%= q %>"</strong></div>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing.id %>" class="listing-link">
      <div class="card col listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" style="height:20rem">
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <% if (listing.categories && listing.categories[0]) { %>
            <span class="category-tag" onclick="event.preventDefault(); window.location='/listings?filter=<%= encodeURIComponent(listing.categories[0]) %>';"><%= listing.categories[0] %></span>
          <% } %>
          <p class="card-text">
            <b><%= listing.title %></b><br>
            <%= listing.description %> <br>
            ₹ <%= listing.price.toLocaleString("en-IN") %> / Night
            <i class="tax-info">&nbsp;+18% GST</i>
          </p>
          <p>Location: <%= listing.location %>, <%= listing.country %></p>
        </div>
      </div>
    </a>
  <% } %>
</div>
<!-- tax switch handled in /js/filters.js -->
