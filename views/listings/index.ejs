<% layout('/layouts/boilerplate') %>
  <!-- <h3>All Listings</h3> -->
  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
      
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      opacity: 0.7;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .filter p {
      margin-top: 0.3rem;
      font-size: 0.8rem;
    }
    .tax-info{
      display: none;
    }
    .tax-toggle{
      border: 1px solid lightgray;
      border-radius: 1rem;
      padding: 1rem;
      margin-left: 3rem;
      display: flex;
      align-items: center;
      height: 2rem;
      
    
    }
  </style>
  <div id="filters">
    <div class="filter">
      <div> <i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-location-dot"></i></div>
      <p>Nearby</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-mountain-sun"></i></div>
      <p>Mountains</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-person-swimming"></i></div>
      <p> Amazing Pools</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-place-of-worship"></i></div>
      <p>Castles</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
    <div class="filter">
      <div> <i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display Total after taxes</label>
      </div>
    </div>
  </div>

  <!-- Mobile: show only first 4 filters, move rest into slide panel -->
  <button id="filters-more-btn" class="btn btn-sm" style="display:none; margin-top: .5rem;">More</button>

  <style>
    /* Slide panel for extra filters on small screens */
    .filters-panel-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      opacity: 0;
      visibility: hidden;
      transition: opacity .25s ease;
      z-index: 1050;
    }
    .filters-panel-backdrop.open { opacity: 1; visibility: visible; }
    .filters-panel {
      position: fixed; right: 0; top: 0; bottom: 0;
      width: 80%; max-width: 320px; background: #fff;
      box-shadow: -6px 0 18px rgba(0,0,0,0.12);
      transform: translateX(100%); transition: transform .3s ease; z-index: 1060;
      padding: 1rem; overflow-y: auto;
    }
    .filters-panel.open { transform: translateX(0); }
    .filters-panel .close-panel { display:block; margin-left:auto; margin-bottom:.5rem; }
    .filters-panel .filter { margin: .5rem 0; }
    @media (max-width: 576px) {
      #filters { gap: .5rem; }
      #filters-more-btn { display:inline-block; }
    }
  </style>

  <div id="filters-panel-backdrop" class="filters-panel-backdrop" aria-hidden="true"></div>
  <aside id="filters-panel" class="filters-panel" aria-hidden="true" role="dialog" aria-label="More filters">
    <button id="filters-close" class="btn btn-sm btn-light close-panel">Close</button>
    <div id="filters-panel-content"></div>
  </aside>

  <script>
    (function(){
      const moreBtn = document.getElementById('filters-more-btn');
      const filters = document.querySelectorAll('#filters .filter');
      const panel = document.getElementById('filters-panel');
      const panelContent = document.getElementById('filters-panel-content');
      const backdrop = document.getElementById('filters-panel-backdrop');
      const closeBtn = document.getElementById('filters-close');

      function openPanel(){ panel.classList.add('open'); backdrop.classList.add('open'); panel.setAttribute('aria-hidden','false'); backdrop.setAttribute('aria-hidden','false'); }
      function closePanel(){ panel.classList.remove('open'); backdrop.classList.remove('open'); panel.setAttribute('aria-hidden','true'); backdrop.setAttribute('aria-hidden','true'); }

      function arrangeFilters(){
        panelContent.innerHTML = '';
        if(window.innerWidth <= 576){
          moreBtn.style.display = 'inline-block';
          filters.forEach((el, idx) => {
            if(idx >= 4){
              const clone = el.cloneNode(true);
              panelContent.appendChild(clone);
              el.style.display = 'none';
            } else { el.style.display = ''; }
          });
        } else {
          moreBtn.style.display = 'none';
          filters.forEach(el => el.style.display = '');
        }
      }

      arrangeFilters();
      window.addEventListener('resize', arrangeFilters);
      moreBtn.addEventListener('click', function(e){ e.preventDefault(); openPanel(); });
      closeBtn.addEventListener('click', function(e){ e.preventDefault(); closePanel(); });
      backdrop.addEventListener('click', function(){ closePanel(); });
    })();
  </script>

  <% if (typeof q !== 'undefined' && q && q.trim().length > 0) { %>
    <div class="mb-3"><strong>Search results for "<%= q %>"</strong></div>
  <% } %>

  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%= listing.id %>" class="listing-link">
        <div class="card col listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" style="height:20rem">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b>
                <%= listing.title %>
              </b><br>
              <%= listing.description %> <br>
                &#8377;<%= listing.price.toLocaleString("en-IN") %> / Night
                <i class="tax-info">&nbsp;+18% GST</i>
                  <p>Location: <%= listing.location %>, <%= listing.country %>
                  </p>
          </div>
        </div>
      </a>
      <% } %>
  </div>
  <script>
    let taxSwitch = document.getElementById('switchCheckDefault');
    taxSwitch.addEventListener('click', function () {
      let taxInfo = document.getElementsByClassName('tax-info');
      for(info of taxInfo){
        if(taxSwitch.checked){
          info.style.display = 'inline';
        } else {
          info.style.display = 'none';
        }
      }
    });
      
  </script>