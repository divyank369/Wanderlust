<% layout('/layouts/boilerplate') %>

<!-- Pass variables required by map.js -->
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = JSON.parse('<%- JSON.stringify((listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates : [0, 0]) %>');
  const listingTitle = "<%= listing.title %>";
</script>

<div class="row">
  <div class="col-12 col-md-8 offset-md-3 mt-3">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-12 col-md-6 offset-md-3 show-card">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image">
    <div class="card-body">
      <p class="card-text"></p>

      <p class="card-text"><i><b>Owner:</b> <%= listing.owner.username %></i></p>
      <p class="card-text"><b>Description:</b> <%= listing.description %></p>
      <p class="card-text"><b>Price:</b> &#8377; <%= listing.price.toLocaleString("en-IN") %></p>
      <p class="card-text"><b>Location:</b> <%= listing.location %></p>
      <p class="card-text"><b>Country:</b> <%= listing.country %></p>
    </div>
  </div>

  <br />

  <% if (currentUser && currentUser._id.equals(listing.owner._id)) { %>
  <div class="row btns mt-3 mb-3">
    <div class="col-12 col-md-4 offset-md-3 d-flex gap-2">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  </div>
  <% } %>

  <div class="col-12 col-md-8 offset-md-3 mt-3 mb-3">
    <hr>

    <% if (currentUser) { %>
    <h3>Leave a review</h3>

    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
      <div class="mb-3 mt-3">
        <label class="form-label"><b>Rating</b></label>

        <div class="rating-control">
          <fieldset class="starability-slot" role="radiogroup" aria-labelledby="ratingLabel">
            <legend id="ratingLabel" class="visually-hidden">Rate this listing:</legend>

            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1">1</label>

            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2">2</label>

            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3">3</label>

            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4">4</label>

            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5">5</label>
          </fieldset>
        </div>
      </div>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label"><b>Comment</b></label>
        <textarea id="comment" name="review[comment]" cols="30" rows="5" class="form-control" required></textarea>
        <div class="invalid-feedback">Please enter a comment.</div>
      </div>

      <button class="btn btn-outline-dark mt-3">Submit</button>
    </form>

    <hr>
    <% } %>

    <% if (listing.reviews.length > 0) { %>
    <div class="row">
      <p><b>All Reviews</b></p>

      <% for (review of listing.reviews) { %>
      <div class="card col-12 col-md-5 ms-md-2 mb-3">
        <div class="card-body">
          <h5 class="card-title">@<%= review.author.username %></h5>
          <p class="card-text">
            <span class="rating-stars" style="--rating: <%= review.rating %>"></span>
            &nbsp;Rated: <%= review.rating %> stars
          </p>
          <p class="card-text"><%= review.comment %></p>

          <form class="d-inline" method="POST"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-dark mb-3">Delete</button>
          </form>
        </div>
      </div>
      <% } %>

    </div>
    <% } %>

  </div>

  <div class="col-12 col-md-8 offset-md-3 mt-3 mb-3">
    <h3>Where you'll be</h3>
    <div id="map"></div>
  </div>

</div>

<!-- Load map.js AFTER variables are defined -->
<script src="/js/map.js"></script>
